{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "easytier-cfworker",
  "main": "./worker.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  // 自定义域不在此声明（保持仓库无隐私信息）：wrangler deploy 会删除未声明的
  // custom domains，因此 CI 在部署后通过 API 从 Secrets 重新绑定。
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "vars": {
    "EASYTIER_OBJECT_NAME": "pv2",
    "EASYTIER_ENABLE_ENCRYPTION": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EASYTIER_CORE",
        "class_name": "EasyTierCoreObject"
      }
    ]
  },
  "exports": {
    "EasyTierCoreObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
